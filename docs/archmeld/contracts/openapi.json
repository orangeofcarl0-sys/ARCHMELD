    "/v1/events": {
      "get": {
        "operationId": "watchEvents",
        "summary": "Replayable server-sent events; each data payload validates Event",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after_sequence",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream; durable per-project sequence",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Each data field is a serialized Event"
                }
              }
            }
          },
          "409": {
            "description": "Cursor no longer available; resync required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/archmeld.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
