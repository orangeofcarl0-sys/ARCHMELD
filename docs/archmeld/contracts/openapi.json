{
  "openapi": "3.1.0",
  "info": {
    "title": "ARCHMELD local core specification",
    "version": "1.0.0",
    "description": "Design contract, not a running service. Server chooses an ephemeral loopback port and passes token through authenticated parent IPC. All responses are project-authorized; identifiers are not access capabilities."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "8765",
          "description": "Example only. Actual ephemeral port supplied by parent; never fixed-port trust."
        }
      }
    }
  ],
  "security": [
    {
      "LocalBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "LocalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-process secret from trusted parent; not URL, repository or stdout"
      }
    }
  },
